CONFIG_MODE=local           # Uses local runtime values instead of an external source.
dbpassword=BuildPassword1   # Local database password for fallback runs.
vncpwd=DashboardPassword1   # Dashboard password for local fallback runs.
app_user=PG                 # Application user name inside the VM/container.
app_user_pwd=AppPassword1   # Password for the application user.
web_title=Peak Gear LiveStack  # Title shown in the web UI.
compartment_ocid=           # Optional compartment OCID override for local fallback.
adb_user=PG                 # ADB user name for the local fallback environment.
adb_password=AppPassword1   # ADB password for the local fallback environment.
adb_service=PEAKGEAR_high   # ADB service name used by the local fallback environment.
adb_wallet_password=WalletPassword1  # Wallet password for the local fallback environment.
onnx_model_url_local=<approved-private-direct-download-url-for-all_MiniLM_L12_v2.onnx>  # Local-only fallback; treat PAR URLs as secrets.
