[Unit]
Description=Provision additional PeakGear medallion Data Transforms project
After=network-online.target pg-iceberg-connection.service pg-ai-catalog-bronze.service
Requires=pg-iceberg-connection.service pg-ai-catalog-bronze.service
Wants=pg-ai-catalog-bronze.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=1800
ExecStart=/bin/bash /home/opc/init/create-medallion-project.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
