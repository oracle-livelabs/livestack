%% PeakGear LiveStack current architecture
%% Render with any Mermaid-compatible viewer.

flowchart LR
  User["Demo user / seller"]
  Browser["Browser\nPeakGear UI\nhttp://host:8505"]

  subgraph OCI["OCI / Terraform Provisioning"]
    TF["Terraform\ncreates compute + ADB\npasses metadata"]
    ADB["Autonomous Database\nADB 23ai / 26ai\nschema PG"]
    OCIObj["OCI Object Storage\nPAR URLs / wallet archive\nimage upload target"]
    OCIAPI["OCI API key metadata\nuser / tenancy / fingerprint / private key"]
    GenAI["OCI Generative AI\ncohere.command-a-03-2025\ncohere.embed-v4.0 configured"]
  end

  subgraph Host["OCI Compute Host / Oracle Linux"]
    Inst["inst.sh\npackages, firewall,\npodman-compose, build_dev.zip"]
    SetEnv["init/setenv.sh + variable.sh\nmetadata -> /home/opc/ingestion/.env"]
    WalletSvc["adb-wallet.service\none-time wallet download\n/home/opc/ingestion/wallet"]
    LoadSvc["adb-load.service / adb-load.sh\none-time SQLcl ADB bootstrap"]
    PodmanSvc["user-podman.service\nstarts compose stack"]
    Done["Marker files\n.wallet_done\n.adb_load_done"]
  end

  subgraph Compose["Podman Compose Stack / /home/opc/ingestion"]
    App["app container\nNode API + React build\npublic port 8505"]
    LocalDB["db container\nOracle Free 23ai\nFREEPDB1 / PG"]
    LocalORDS["ords container\nlocal ORDS\npublic port 8181"]
    ORDSSetup["ords-pg-setup\none-shot PG ORDS enablement"]
    PrivateAI["privateai container\nembedding API\ninternal port 8080"]
    Ollama["ollama container\nllama3.2 fallback\npublic port 11434"]

    subgraph GGSA["GoldenGate Stream Analytics container"]
      OSA["OSA UI/API\npublic port 8085\nadmin osaadmin"]
      Kafka["Kafka broker\npublic port 9092\ninternal localhost:19092"]
      Spark["Spark runtime\nports 4040-4050, 6066,\n7077, 28080-28083"]
      OSAStore["OSA MySQL + deployed pipelines\npersistent volumes"]
    end

    SignalGen["signal-generator\nFaker demand events\nhttp://ggsa:18088"]

    Gravitino["Gravitino Iceberg REST\nADW catalog backend\npublic port 1525"]
    GravitinoArchive["ADW-enabled Gravitino ZIP\nstaged at install time"]
  end

  subgraph ADBLayer["ADB PG Lakehouse / External Data Plane"]
    Bronze["Bronze layer\nPG.BRONZE_* including\nBRONZE_DEMAND_SIGNALS"]
    Silver["Silver layer\nPG.SILVER_*"]
    Gold["Gold + app objects\ncatalog, orders, inventory,\nagent support views"]
    ADBProfiles["DBMS_CLOUD_AI profiles\nPG_GENAI_PROFILE\nCOHERE_RAG"]
    ReturnAgentADB["ADB Select AI Agent team\nRETURN_ADVISOR_TEAM\nnotebook return advisor tools"]
    ADBORDS["ADB ORDS / DB Actions\nData Studio, Data Transforms"]
  end

  subgraph LocalDBLayer["Local App DB PG / Operational App Data"]
    AppTables["Core app tables\nproducts, brands, orders,\ncustomers, inventory,\nfulfillment, social signals"]
    Vectors["Vector tables + ONNX\nPRODUCT_EMBEDDINGS\nSIGNAL_EMBEDDINGS\nALL_MINILM_L12_V2"]
    AppAgents["App DB Select AI agents\nSOCIAL_TREND_TEAM\nFULFILLMENT_TEAM\nCOMMERCE_TEAM"]
    Audit["AI agent audit logs\nservice events\nuser/session state"]
  end

  subgraph DemoFlows["Primary Demo Flows"]
    StreamingFlow["Real-Time Streaming\nstart/stop generator\nKafka -> OSA -> ADB Bronze"]
    LakehouseFlow["AI Lakehouse setup\nwallet connect, seed,\nBronze/Silver/Gold status"]
    AskDataFlow["Ask Your Data\nSelect AI when OCI GenAI is available\nOllama fallback otherwise"]
    WebshopFlow["PeakGear Webshop\nsemantic search, visual search,\nAsk PeakGear returns agent"]
    AgentFlow["LiveStack Agents\noperations agent workflows\ntrend, fulfillment, commerce"]
    IcebergFlow["Gravitino / OCI Object Storage\nIceberg catalog for Data Transforms"]
  end

