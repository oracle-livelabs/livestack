[Unit]
Description=Podman Compose App
After=network-online.target adb-wallet.service adb-load.service pg-ai-data-catalog.service
Wants=network-online.target adb-wallet.service adb-load.service pg-ai-data-catalog.service

[Service]
Type=simple
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=PODMAN_USERNS=keep-id
Restart=always
TimeoutStartSec=420
TimeoutStopSec=420
WorkingDirectory=/home/opc/ingestion

ExecStartPre=/bin/bash -c '/home/opc/init/setenv.sh'

ExecStartPre=/bin/bash -lc 'set -a; source /home/opc/ingestion/.env; set +a; compose_files=(-f compose.yml); if [[ "$${SOURCE_DATABASE_TLS_ENABLED:-false}" == "true" ]]; then compose_files+=(-f compose.source-tls.yml); fi; /usr/local/bin/podman-compose "$${compose_files[@]}" down'
#ExecStartPre=/usr/bin/podman-compose down

# Start the compose app
ExecStart=/bin/bash -lc 'set -a; source /home/opc/ingestion/.env; set +a; compose_files=(-f compose.yml); if [[ "$${SOURCE_DATABASE_TLS_ENABLED:-false}" == "true" ]]; then compose_files+=(-f compose.source-tls.yml); fi; if [[ "$${AIHUB:-false}" == "true" ]]; then exec /usr/local/bin/podman-compose "$${compose_files[@]}" --profile aihub up; fi; exec /usr/local/bin/podman-compose "$${compose_files[@]}" up'
#ExecStart=/usr/bin/podman-compose up

[Install]
WantedBy=default.target
