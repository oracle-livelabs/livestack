[Unit]
Description=Seed optional AI Catalog bronze sources and PG external tables
After=network-online.target pg-ai-data-catalog.service user-podman.service
Wants=network-online.target pg-ai-data-catalog.service

[Service]
Type=oneshot
TimeoutStartSec=1230
ExecStart=/bin/bash /home/opc/init/retry-provision-step.sh ai-catalog-bronze /bin/bash /home/opc/init/seed-ai-data-catalog.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target
