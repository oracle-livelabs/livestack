NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:8505

ORACLE_DB_IMAGE=container-registry.oracle.com/database/free:latest
ORDS_IMAGE=container-registry.oracle.com/database/ords:latest
OLLAMA_IMAGE=docker.io/ollama/ollama:latest

ORACLE_PWD=oracle
ORACLE_CHARACTERSET=AL32UTF8
APP_SCHEMA_PASSWORD=livestackrulez!
ORACLE_USER=LIVESTACK
ORACLE_CONNECTION_STRING=db:1521/FREEPDB1

CONN_STRING=db:1521/FREEPDB1
DBHOST=db
DBPORT=1521
DBSERVICENAME=FREEPDB1

ORDS_PORT=8181
OLLAMA_PORT=11434
APP_PORT=8505

ONNX_MODEL_FILENAME=all_MiniLM_L12_v2.onnx
# Required only when the model is not already present in DATA_PUMP_DIR.
# Inject the deployment-specific model URL through a local .env or deployment secret.
ONNX_MODEL_URL=<deployment-local-model-url>

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# Usage telemetry
# Keep the example inert. Set the real bearer-style endpoint only in a local
# .env excluded from source control or through the deployment secret manager.
DEMO_USAGE_COUNTER_PAR_URL=<deployment-local-secret>
DEMO_USAGE_COUNTER_PREFIX=utilities-demo-usage/events
DEMO_USAGE_COUNTER_DEMO_ID=utilities
DEMO_USAGE_COUNTER_TIMEOUT_MS=3000
